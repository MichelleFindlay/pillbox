# Pillbox - used when the whole folder is uploaded into the web root.
# Best practice is to point the site's DocumentRoot at public/ instead,
# in which case this file is not used.

Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Block the application's private folders and files.
    RewriteRule ^(src|config|database|storage)(/|$) - [F,L]
    RewriteRule (^|/)\. - [F,L]
    RewriteRule \.(sql|md|example)$ - [F,L]
    # Serve everything else from public/.
    RewriteCond %{REQUEST_URI} !/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
